APP_ENV=development
DATABASE_URL=sqlite:///./arena360.db
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploy
JWT_EXPIRE_MINUTES=60
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:3000
ADMIN_BOOTSTRAP_KEY=
# QPay Merchant V2 — keep production credentials in the deployment secret store
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# Public HTTPS API origin; callback path is appended by the API
QPAY_CALLBACK_URL=https://api.example.mn
